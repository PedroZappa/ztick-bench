# SPDX-License-Identifier: MIT
# Doxygen configuration for ztick-bench.
# Generated documentation lives in build/docs (gitignored via build/).

PROJECT_NAME           = "ztick-bench"
PROJECT_NUMBER         = 0.3.0-dev
PROJECT_BRIEF          = "Portable DSP benchmarking framework"

OUTPUT_DIRECTORY       = build/docs
HTML_OUTPUT            = cpp
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

OUTPUT_LANGUAGE        = English
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES

INPUT                  = .
FILE_PATTERNS          = *.h *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE                = .git build
EXCLUDE_PATTERNS       = */build/* */cmake-build-*/*

HAVE_DOT               = NO
