# Package configuration for find_package(ztick-sdk).
# Generated by configure_package_config_file; the PACKAGE_INIT expansion below
# makes the package relocatable by resolving PACKAGE_PREFIX_DIR relative to this file.
@PACKAGE_INIT@

# Informational tool version (for example "0.3.0-dev"); not used for ABI checks.
set(ztick-sdk_PROJECT_VERSION "@ZTICK_VERSION_DISPLAY@")

include("${CMAKE_CURRENT_LIST_DIR}/ztick-sdk-targets.cmake")

check_required_components(ztick-sdk)
